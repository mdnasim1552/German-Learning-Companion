@code {
    private List<VocabularyWord> allWords = new();
    private List<VocabularyWord> cards = new();

    private readonly HashSet<int> knownIds = new();
    private readonly HashSet<int> practiceIds = new();

    private int currentIndex;
    private bool isFlipped;
    private bool isLoading;
    private string selectedLevel = "All";
    private string errorMessage = string.Empty;

    private VocabularyWord CurrentWord => cards[currentIndex];

    private int ProgressPercentage =>
        cards.Count == 0
            ? 0
            : (int)Math.Round(
                (double)(knownIds.Count + practiceIds.Count)
                / cards.Count * 100);

    private int RemainingCount =>
        Math.Max(0, cards.Count - knownIds.Count - practiceIds.Count);

    private string selectedReviewMode = "Due";

    protected override async Task OnInitializedAsync()
    {
        await LoadWords();
    }

    private async Task LoadWords()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            allWords = await db.VocabularyWords
                .AsNoTracking()
                .OrderBy(w => w.German)
                .ToListAsync();

            ApplyLevelFilter();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load vocabulary: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    
    private void ApplyLevelFilter()
    {
        var now = DateTime.UtcNow;

        IEnumerable<VocabularyWord> query = allWords;

        if (selectedReviewMode == "Due")
        {
            query = query.Where(w =>
                w.NextReviewAt == null ||
                w.NextReviewAt.Value <= now);
        }

        if (selectedLevel != "All")
        {
            query = query.Where(w => w.Level == selectedLevel);
        }

        cards = query
            .OrderBy(w => w.NextReviewAt ?? DateTime.MinValue)
            .ThenBy(w => w.German)
            .ToList();

        currentIndex = 0;
        isFlipped = false;

        var currentIds = cards.Select(w => w.Id).ToHashSet();
        knownIds.IntersectWith(currentIds);
        practiceIds.IntersectWith(currentIds);
    }

    private void OnReviewModeChanged(ChangeEventArgs args)
    {
        selectedReviewMode = args.Value?.ToString() ?? "Due";
        ApplyLevelFilter();
    }


    private void OnLevelChanged(ChangeEventArgs args)
    {
        selectedLevel = args.Value?.ToString() ?? "All";
        ApplyLevelFilter();
    }

    private void FlipCard()
    {
        isFlipped = !isFlipped;
    }

    private void PreviousCard()
    {
        if (currentIndex > 0)
        {
            currentIndex--;
            isFlipped = false;
        }
    }

    private void NextCard()
    {
        if (currentIndex < cards.Count - 1)
        {
            currentIndex++;
            isFlipped = false;
        }
    }

    
    private async Task MarkAsKnown()
    {
        await SaveReviewResult(known: true);
    }

    private async Task MarkForPractice()
    {
        await SaveReviewResult(known: false);
    }

    private async Task SaveReviewResult(bool known)
    {
        if (cards.Count == 0)
            return;

        errorMessage = string.Empty;

        var word = CurrentWord;
        var reviewedAt = DateTime.UtcNow;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var savedWord = await db.VocabularyWords
                .FirstOrDefaultAsync(w => w.Id == word.Id);

            if (savedWord is null)
            {
                errorMessage = "This vocabulary word could not be found.";
                return;
            }

            savedWord.LastReviewedAt = reviewedAt;
            savedWord.ReviewCount++;

            if (known)
            {
                savedWord.CorrectStreak++;
            }
            else
            {
                savedWord.CorrectStreak = 0;
            }

            savedWord.NextReviewAt =
                GetNextReviewDate(reviewedAt, savedWord.CorrectStreak);

            await db.SaveChangesAsync();

            // Update the in-memory card without reloading the deck.
            word.LastReviewedAt = savedWord.LastReviewedAt;
            word.ReviewCount = savedWord.ReviewCount;
            word.CorrectStreak = savedWord.CorrectStreak;
            word.NextReviewAt = savedWord.NextReviewAt;

            if (known)
            {
                knownIds.Add(word.Id);
                practiceIds.Remove(word.Id);
            }
            else
            {
                practiceIds.Add(word.Id);
                knownIds.Remove(word.Id);
            }

            MoveToNextUnreviewedCard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not save your review: {ex.Message}";
        }
    }

    private static DateTime GetNextReviewDate(
        DateTime reviewedAt,
        int correctStreak)
    {
        int days = correctStreak switch
        {
            0 => 1,
            1 => 1,
            2 => 3,
            3 => 7,
            4 => 14,
            _ => 30
        };

        return reviewedAt.AddDays(days);
    }


    private void MoveToNextUnreviewedCard()
    {
        isFlipped = false;

        if (cards.Count == 0)
            return;

        // Find the next card that has not been rated in this session.
        for (int offset = 1; offset <= cards.Count; offset++)
        {
            int candidate = (currentIndex + offset) % cards.Count;
            int id = cards[candidate].Id;

            if (!knownIds.Contains(id) && !practiceIds.Contains(id))
            {
                currentIndex = candidate;
                return;
            }
        }

        // All cards have been reviewed.
        StateHasChanged();
    }

    private void ShuffleCards()
    {
        cards = cards.OrderBy(_ => Random.Shared.Next()).ToList();
        currentIndex = 0;
        isFlipped = false;
    }

    private void ResetSession()
    {
        knownIds.Clear();
        practiceIds.Clear();
        currentIndex = 0;
        isFlipped = false;
    }
}
