@page "/flashcards"

@using GermanLearningCompanion.Data
@using GermanLearningCompanion.Models
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Flashcards - German Learning</PageTitle>

<div class="flash-page">
    <div class="flash-header">
        <div>
            <h1>German Flashcards</h1>
            <p>Practice your vocabulary, one word at a time.</p>
        </div>

        <button class="secondary-btn"
                @onclick="ResetSession">
            Reset progress
        </button>
    </div>
    <div class="flash-toolbar">
        <label for="reviewMode">Study mode</label>

        <select id="reviewMode"
                value="@selectedReviewMode"
                @onchange="OnReviewModeChanged">
            <option value="Due">Daily review (due words)</option>
            <option value="All">All words</option>
        </select>

        <label for="levelFilter">German level</label>

        <select id="levelFilter"
                value="@selectedLevel"
                @onchange="OnLevelChanged">
            <option value="All">All levels</option>
            <option value="A1">A1 - Beginner</option>
            <option value="A2">A2 - Elementary</option>
            <option value="B1">B1 - Intermediate</option>
            <option value="B2">B2 - Upper intermediate</option>
        </select>

        <button class="secondary-btn"
                @onclick="ShuffleCards"
                disabled="@(cards.Count < 2)">
            Shuffle
        </button>
    </div>

    @if (isLoading)
    {
        <div class="status-message">Loading your vocabulary...</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-message">@errorMessage</div>
        <button class="primary-btn" @onclick="LoadWords">
            Try again
        </button>
    }
    else if (cards.Count == 0)
    {
        <div class="empty-state">
            <h3>No vocabulary found</h3>
            <p>
                Add some words on the Vocabulary page to start
                practicing your German.
            </p>
            <a href="/vocabulary" class="primary-btn">
                Add vocabulary
            </a>
        </div>
    }
    else
    {
        <div class="progress-section">
            <div class="progress-labels">
                <span>Card @(currentIndex + 1) of @cards.Count</span>
                <span>@ProgressPercentage% completed</span>
            </div>

            <div class="progress-track">
                <div class="progress-fill"
                     style="width: @(ProgressPercentage)%">
                </div>
            </div>
        </div>

        <button type="button"
                class="flash-card @(isFlipped ? "flipped" : "")"
                @onclick="FlipCard"
                aria-label="Flip vocabulary card">
            @if (!isFlipped)
            {
                <div class="card-content">
                    <span class="card-label">GERMAN</span>

                    <span class="german-word">
                        @if (!string.IsNullOrWhiteSpace(CurrentWord.Article))
                        {
                            @CurrentWord.Article
                        }
                        @CurrentWord.German
                    </span>

                    @if (!string.IsNullOrWhiteSpace(CurrentWord.Plural))
                    {
                        <span class="plural-text">
                            Plural: @CurrentWord.Plural
                        </span>
                    }

                    <span class="flip-hint">
                        Tap the card to reveal the answer
                    </span>
                </div>
            }
            else
            {
                <div class="card-content">
                    <span class="card-label">MEANING</span>

                    <span class="translation">
                        @CurrentWord.English
                    </span>

                    @if (!string.IsNullOrWhiteSpace(CurrentWord.Bengali))
                    {
                        <span class="bengali-text">
                            @CurrentWord.Bengali
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(CurrentWord.Example))
                    {
                        <div class="example-box">
                            <strong>Example</strong>
                            <p>@CurrentWord.Example</p>
                        </div>
                    }

                    <span class="level-badge">
                        @CurrentWord.Level
                    </span>
                </div>
            }
        </button>

        <div class="study-actions">
            <button class="practice-btn"
                    @onclick="MarkForPractice">
                <span>✕</span>
                Need practice
            </button>

            <button class="known-btn"
                    @onclick="MarkAsKnown">
                <span>✓</span>
                I know this
            </button>
        </div>

        <div class="navigation-actions">
            <button class="secondary-btn"
                    @onclick="PreviousCard"
                    disabled="@(currentIndex == 0)">
                ← Previous
            </button>

            <button class="secondary-btn"
                    @onclick="NextCard"
                    disabled="@(currentIndex >= cards.Count - 1)">
                Next →
            </button>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-number">@knownIds.Count</span>
                <span class="stat-label">Known</span>
            </div>

            <div class="stat-card">
                <span class="stat-number">@practiceIds.Count</span>
                <span class="stat-label">Need practice</span>
            </div>

            <div class="stat-card">
                <span class="stat-number">@RemainingCount</span>
                <span class="stat-label">Not reviewed</span>
            </div>
        </div>

        @if (knownIds.Count + practiceIds.Count == cards.Count)
        {
            <div class="completion-message">
                <h3>Session completed!</h3>
                <p>
                    Great work! You reviewed all @cards.Count cards
                    in this session.
                </p>
                <button class="primary-btn" @onclick="ResetSession">
                    Practice again
                </button>
            </div>
        }
    }
</div>

<style>
